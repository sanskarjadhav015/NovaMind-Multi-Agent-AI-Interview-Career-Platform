# ==========================================
# NovaMind AI Interview Platform - .gitignore
# ==========================================

# 1. Environment & Secrets (CRITICAL)
.env
.env.*
*.env
*.env.*
!.env.example
!.env.*.example
*serviceAccount*.json
*serviceAccountKey*.json
!*example.json
credentials.json
*.pem
*.key

# 2. Dependencies
node_modules/
*/node_modules/
*/*/node_modules/
*/*/*/node_modules/

# 3. Build & Distribution Outputs
dist/
dist-ssr/
build/
out/
.next/
*.tsbuildinfo

# 4. Uploads & Temporary User Files
backend/services/resume/uploads/*
!backend/services/resume/uploads/.gitkeep
uploads/
tmp/
temp/
*.pdf

# 5. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 6. OS & System Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 7. IDE & Code Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# 8. Local Docker & Cache Overrides
docker-compose.override.yml
.eslintcache
.cache/
